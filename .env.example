# Shared by all three backend services. Generate a unique random value.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Docker creates the application user named app. For existing MySQL, use its application account.
DB_USERNAME=app
DB_PASSWORD=replace-with-a-database-password
# Used only when creating the Docker MySQL instance.
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
# Enable only to create the first local administrator, then disable again.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_PASSWORD=
